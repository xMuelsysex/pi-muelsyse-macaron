{
  "name": "pi-muelsyse-macaron",
  "version": "1.2.1",
  "description": "Lightweight Muelsyse Macaron visual pack for Pi: theme, ANSI art header, macaron Zentui chrome, Claude-style shimmer, optional matrix rain.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi-extension",
    "tui",
    "muelsyse",
    "macaron"
  ],
  "files": [
    "extensions",
    "themes",
    "licenses",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:open-tui": "node scripts/preview.mjs --open-tui",
    "typecheck": ".dev/node_modules/.bin/tsc -p tsconfig.json",
    "test": "node --experimental-transform-types --no-warnings --import ./test/register.mjs --test \"test/**/*.test.ts\"",
    "verify": "npm run check && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "preview": {
    "skills": [
      "~/.pi/agent/npm/node_modules/pi-maestro-flow/.pi/skills"
    ],
    "extensions": [
      "~/.pi/agent/npm/node_modules/pi-maestro-flow/src/extension/index.ts",
      "~/.pi/agent/npm/node_modules/pi-maestro-flow/src/advisor/extension.ts",
      "~/.pi/agent/npm/node_modules/pi-maestro-flow/src/self-evolve/extension.ts",
      "~/.pi/agent/npm/node_modules/pi-maestro-flow/src/submit-gate/extension.ts",
      "~/.pi/agent/npm/node_modules/pi-maestro-flow/src/classifier/extension.ts",
      "~/.pi/agent/npm/node_modules/pi-maestro-teammate/src/extension/index.ts",
      "~/.pi/agent/npm/node_modules/pi-cockpit/src/extension/index.ts"
    ],
    "openTuiExtensions": [
      "~/.pi/agent/npm/node_modules/pi-open-tui/extensions/open-tui/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/header/index.ts",
      "./extensions/matrix/index.ts",
      "./extensions/zentui/index.ts",
      "./extensions/claude-shimmer/index.ts",
      "./extensions/changelog/index.ts"
    ],
    "themes": [
      "./themes/muelsyse-macaron.json"
    ]
  }
}
